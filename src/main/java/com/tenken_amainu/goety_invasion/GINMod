    public GINMod() {
        IEventBus modEventBus = FMLJavaModLoadingContext.get().getModEventBus();
        ENTITY_TYPES.register(modEventBus);
        ITEMS.register(modEventBus);
        TABS.register(modEventBus);
        MENU_TYPES.register(modEventBus);
        MOB_EFFECTS.register(modEventBus);
        BLOCKS.register(modEventBus);
        BLOCK_ENTITY.register(modEventBus);
        PARTICLE_TYPES.register(modEventBus);
        SOUND_EVENTS.register(modEventBus);

        modEventBus.addListener(this::commonSetup);
        modEventBus.addListener(this::registerAttributes);
        modEventBus.addListener(this::addPackFinders);
        MinecraftForge.EVENT_BUS.register(this);

        ModLoadingContext.get().registerConfig(
                ModConfig.Type.COMMON, GINSpellConfig.SPEC, "goety_invasion-spells.toml");
        ModLoadingContext.get().registerConfig(
                ModConfig.Type.COMMON, GINServantConfig.SPEC, "goety_invasion-servants.toml");
    }

    private void commonSetup(final FMLCommonSetupEvent event) {
        event.enqueueWork(() -> {
            IllagerType.create("MARAUDER", new GINIllagerType());
            IllagerType.create("INQUISITOR", new GINIllagerType());
            IllagerType.create("BASHER", new GINIllagerType());
            IllagerType.create("PROVOKER", new GINIllagerType());
            IllagerType.create("SORCERER", new GINIllagerType());
            IllagerType.create("ALCHEMIST", new GINIllagerType());
            IllagerType.create("FIRECALLER", new GINIllagerType());
        });
    }

    private void registerAttributes(EntityAttributeCreationEvent event) {
        event.put(MARAUDER_SERVANT.get(), MarauderServant.createAttributes().build());
        event.put(ALLY_SURRENDERED.get(), Minion.createMobAttributes().build());
        event.put(INQUISITOR_SERVANT.get(), InquisitorServant.setCustomAttributes().build());
        event.put(PROVOKER_SERVANT.get(), ProvokerServant.setCustomAttributes().build());
        event.put(BASHER_SERVANT.get(), BasherServant.setCustomAttributes().build());
        event.put(BOUND_INVOKER.get(), BoundInvoker.setCustomAttributes().build());
        event.put(ALCHEMIST_SERVANT.get(), AlchemistServant.setCustomAttributes().build());
        event.put(SORCERER_SERVANT.get(), SorcererServant.createAttributes().build());
        event.put(NECROMANCER_SERVANT.get(), NecromancerServant.setCustomAttributes().build());
        event.put(FIRECALLER_SERVANT.get(), FireCallerServant.setCustomAttributes().build());
        event.put(BOUND_FIRECALLER.get(), BoundFireCaller.setCustomAttributes().build());
        event.put(BOUND_SORCERER.get(), BoundSorcerer.setCustomAttributes().build());
    }

    @SubscribeEvent
    public void addPackFinders(AddPackFindersEvent event) {
        if (event.getPackType() != PackType.CLIENT_RESOURCES) return;
        if (ModList.get().isLoaded("goety_integration")) return;

        var resourcePath = ModList.get().getModFileById(MODID).getFile()
                .findResource("resourcepacks/goety_invasion_black_book");

        var pack = Pack.readMetaAndCreate(
                "goety_invasion/goety_invasion_black_book",
                Component.literal("Goety Invasion Black Book Pack"),
                true,
                (path) -> new PathPackResources(path, resourcePath, false),
                PackType.CLIENT_RESOURCES,
                Pack.Position.BOTTOM,
                PackSource.DEFAULT);

        event.addRepositorySource((packConsumer) -> packConsumer.accept(pack));
    }
