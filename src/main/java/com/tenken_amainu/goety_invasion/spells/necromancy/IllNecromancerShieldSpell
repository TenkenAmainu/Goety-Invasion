package com.tenken_amainu.goety_invasion.spells.necromancy;

import com.Polarice3.Goety.api.magic.SpellType;
import com.Polarice3.Goety.common.enchantments.ModEnchantments;
import com.Polarice3.Goety.common.items.ModItems;
import com.Polarice3.Goety.common.magic.Spell;
import com.Polarice3.Goety.common.magic.SpellStat;
import com.Polarice3.Goety.utils.ServantUtil;
import com.Polarice3.Goety.utils.WandUtil;
import com.tenken_amainu.goety_invasion.GINMod;
import com.tenken_amainu.goety_invasion.config.GINSpellConfig;
import fuzs.illagerinvasion.init.ModRegistry;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.sounds.SoundEvent;
import net.minecraft.sounds.SoundSource;
import net.minecraft.world.effect.MobEffectInstance;
import net.minecraft.world.entity.LivingEntity;
import net.minecraft.world.entity.Mob;
import net.minecraft.world.entity.MobType;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.enchantment.Enchantment;

import java.util.List;

public class IllNecromancerShieldSpell extends Spell {

    @Override
    public SpellStat defaultStats() {
        return super.defaultStats().setDuration(20);
    }

    @Override public int defaultSoulCost() { return GINSpellConfig.NecromancerShieldCost.get(); }
    @Override public int defaultCastDuration() { return GINSpellConfig.NecromancerShieldDuration.get(); }
    @Override public int defaultSpellCooldown() { return GINSpellConfig.NecromancerShieldCoolDown.get(); }
    @Override public SoundEvent CastingSound() { return ModRegistry.NECROMANCER_SUMMON_SOUND_EVENT.get(); }
    @Override public SpellType getSpellType() { return SpellType.NECROMANCY; }

    @Override
    public List<Enchantment> acceptedEnchantments() {
        return List.of(ModEnchantments.DURATION.get());
    }

    @Override
    public void SpellResult(ServerLevel worldIn, LivingEntity caster, ItemStack staff, SpellStat spellStat) {
        int baseDurationSeconds = spellStat.getDuration();
        boolean convert = false;

        if (staff.is(ModItems.NAMELESS_STAFF.get())) {
            baseDurationSeconds = 60;
            convert = true;
        } else if (rightStaff(staff)) {
            baseDurationSeconds = 30;
        }

        int extraSeconds = 0;
        if (WandUtil.enchantedFocus(caster)) {
            extraSeconds = WandUtil.getLevels(ModEnchantments.DURATION.get(), caster) * 10;
        }

        int durationTicks = (baseDurationSeconds + extraSeconds) * 20;

        caster.addEffect(new MobEffectInstance(
                GINMod.NECROMANCER_SHIELD.get(), durationTicks, 0, false, false, true));

        if (convert) {
            convertNearbyUndead(worldIn, caster);
        }

        worldIn.playSound(null, caster.blockPosition(),
                ModRegistry.NECROMANCER_SUMMON_SOUND_EVENT.get(),
                SoundSource.PLAYERS, 1.5F, 1.0F);
    }

    private void convertNearbyUndead(ServerLevel level, LivingEntity caster) {
        level.getEntitiesOfClass(LivingEntity.class,
                        caster.getBoundingBox().inflate(10.0),
                        e -> e.getMobType() == MobType.UNDEAD && e.isAlive() && !e.isAlliedTo(caster))
                .forEach(undead -> {
                    ServantUtil.convertZombies(undead, caster, true);
                    ServantUtil.convertSkeletons(undead, caster, false, true);
                    if (undead instanceof Mob mob) {
                        ServantUtil.infect(mob, caster, true, true);
                    }
                });
    }
}
