package com.tenken_amainu.goety_invasion.spells.necromancy;

import com.Polarice3.Goety.api.magic.SpellType;
import com.Polarice3.Goety.common.enchantments.ModEnchantments;
import com.Polarice3.Goety.common.items.ModItems;
import com.Polarice3.Goety.common.magic.Spell;
import com.Polarice3.Goety.common.magic.SpellStat;
import com.Polarice3.Goety.utils.WandUtil;
import com.tenken_amainu.goety_invasion.common.entities.projectiles.AllyNecroSkullBolt;
import com.tenken_amainu.goety_invasion.common.entities.projectiles.AllySkullBolt;
import com.tenken_amainu.goety_invasion.config.GINSpellConfig;
import net.minecraft.core.particles.ParticleTypes;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.sounds.SoundEvent;
import net.minecraft.sounds.SoundEvents;
import net.minecraft.sounds.SoundSource;
import net.minecraft.world.entity.LivingEntity;
import net.minecraft.world.entity.projectile.AbstractHurtingProjectile;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.enchantment.Enchantment;
import net.minecraft.world.phys.Vec3;

import java.util.List;

public class ConjureSkullSpell extends Spell {

    @Override public int defaultSoulCost() { return GINSpellConfig.ConjureSkullCost.get(); }
    @Override public int defaultCastDuration() { return GINSpellConfig.ConjureSkullDuration.get(); }
    @Override public SoundEvent CastingSound() { return SoundEvents.EVOKER_PREPARE_ATTACK; }
    @Override public int defaultSpellCooldown() { return GINSpellConfig.ConjureSkullCoolDown.get(); }
    @Override public SpellType getSpellType() { return SpellType.NECROMANCY; }

    @Override
    public List<Enchantment> acceptedEnchantments() {
        return List.of(ModEnchantments.POTENCY.get(), ModEnchantments.BURNING.get());
    }

    @Override
    public void SpellResult(ServerLevel worldIn, LivingEntity caster, ItemStack staff, SpellStat spellStat) {
        Vec3 view = caster.getViewVector(1.0F);

        double x = caster.getX();
        double y = caster.getEyeY() - 0.5;
        double z = caster.getZ();

        int potency = spellStat.getPotency();
        int burning = spellStat.getBurning();
        if (WandUtil.enchantedFocus(caster)) {
            potency += WandUtil.getLevels(ModEnchantments.POTENCY.get(), caster);
            burning += WandUtil.getLevels(ModEnchantments.BURNING.get(), caster);
        }
        float extraDamage = potency * 2.0F;

        boolean useNecro = staff.is(ModItems.NAMELESS_STAFF.get());

        AbstractHurtingProjectile main = createSkull(worldIn, caster, view, useNecro);
        main.setOwner(caster);
        main.setPosRaw(x, y, z);
        applyEnchantments(main, extraDamage, burning);
        worldIn.addFreshEntity(main);

        if (rightStaff(staff)) {
            for (int i = 0; i < 2; i++) {
                AbstractHurtingProjectile extra = createSkull(worldIn, caster, view, useNecro);
                extra.setOwner(caster);
                extra.setPosRaw(x + worldIn.random.nextGaussian(), y, z + worldIn.random.nextGaussian());
                applyEnchantments(extra, extraDamage, burning);
                worldIn.addFreshEntity(extra);
            }
        }

        worldIn.sendParticles(ParticleTypes.SMOKE, x, y, z, 40, 0.4D, 0.4D, 0.4D, 0.15D);
        worldIn.playSound(null, x, y, z, SoundEvents.WITHER_SHOOT, SoundSource.PLAYERS,
                2.0F, 0.9F + worldIn.random.nextFloat() * 0.2F);
    }

    private AbstractHurtingProjectile createSkull(ServerLevel worldIn, LivingEntity caster, Vec3 view, boolean useNecro) {
        return useNecro
                ? new AllyNecroSkullBolt(worldIn, caster, view.x, view.y, view.z)
                : new AllySkullBolt(worldIn, caster, view.x, view.y, view.z);
    }

    private void applyEnchantments(AbstractHurtingProjectile skull, float extraDamage, int burning) {
        if (skull instanceof AllySkullBolt bolt) {
            bolt.setDamage(7.0F + extraDamage);
        } else if (skull instanceof AllyNecroSkullBolt bolt) {
            bolt.setExtraDamage(extraDamage);
        }
        if (burning > 0) {
            skull.setSecondsOnFire(burning);
        }
    }
}
