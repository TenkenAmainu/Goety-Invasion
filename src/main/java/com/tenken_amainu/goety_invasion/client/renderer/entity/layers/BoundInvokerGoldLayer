package com.tenken_amainu.goety_invasion.client.renderer.entity.layers;

import com.mojang.blaze3d.vertex.PoseStack;
import com.mojang.blaze3d.vertex.VertexConsumer;
import com.tenken_amainu.goety_invasion.GINMod;
import com.tenken_amainu.goety_invasion.common.entities.ally.undead.bound.BoundInvoker;
import net.minecraft.client.model.EntityModel;
import net.minecraft.client.renderer.MultiBufferSource;
import net.minecraft.client.renderer.RenderType;
import net.minecraft.client.renderer.entity.RenderLayerParent;
import net.minecraft.client.renderer.entity.layers.RenderLayer;
import net.minecraft.client.renderer.texture.OverlayTexture;
import net.minecraft.resources.ResourceLocation;

public class BoundInvokerGoldLayer<T extends BoundInvoker, M extends EntityModel<T>> extends RenderLayer<T, M> {
    private static final ResourceLocation GOLD_NORMAL = new ResourceLocation(GINMod.MODID, "textures/entity/servant/bound/bound_invoker_gold.png");
    private static final ResourceLocation GOLD_CASTING = new ResourceLocation(GINMod.MODID, "textures/entity/servant/bound/bound_invoker_gold_casting.png");

    public BoundInvokerGoldLayer(RenderLayerParent<T, M> renderLayerParent) {
        super(renderLayerParent);
    }

    @Override
    public void render(PoseStack poseStack, MultiBufferSource buffer, int packedLight, T livingEntity,
                       float limbSwing, float limbSwingAmount, float partialTick, float ageInTicks,
                       float netHeadYaw, float headPitch) {
        VertexConsumer vertexConsumer = buffer.getBuffer(RenderType.eyes(
                livingEntity.isCastingSpell() ? GOLD_CASTING : GOLD_NORMAL));
        this.getParentModel().renderToBuffer(poseStack, vertexConsumer, 15728640, OverlayTexture.NO_OVERLAY, 1.0F, 1.0F, 1.0F, 1.0F);
    }
}
