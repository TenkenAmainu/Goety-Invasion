package com.tenken_amainu.goety_invasion.common.entities.projectiles;

import com.Polarice3.Goety.utils.MobUtil;
import com.tenken_amainu.goety_invasion.GINMod;
import net.minecraft.core.particles.ParticleTypes;
import net.minecraft.nbt.CompoundTag;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.sounds.SoundEvents;
import net.minecraft.sounds.SoundSource;
import net.minecraft.world.damagesource.DamageSource;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.LivingEntity;
import net.minecraft.world.entity.projectile.AbstractHurtingProjectile;
import net.minecraft.world.level.Level;
import net.minecraft.world.phys.EntityHitResult;
import net.minecraft.world.phys.HitResult;
import net.minecraft.world.phys.Vec3;

import java.util.List;

public class AllyFlyingMagma extends AbstractHurtingProjectile {

    private int extraDamage = 0;
    private int burning = 0;

    public AllyFlyingMagma(EntityType<? extends AllyFlyingMagma> entityType, Level world) {
        super(entityType, world);
    }

    public AllyFlyingMagma(Level world, LivingEntity owner,
                           double directionX, double directionY, double directionZ) {
        super(GINMod.ALLY_FLYING_MAGMA.get(), owner, directionX, directionY, directionZ, world);
    }

    public void setExtraDamage(int extraDamage) { this.extraDamage = extraDamage; }
    public int getExtraDamage() { return this.extraDamage; }
    public void setBurning(int burning) { this.burning = burning; }
    public int getBurning() { return this.burning; }

    @Override
    public void addAdditionalSaveData(CompoundTag tag) {
        super.addAdditionalSaveData(tag);
        tag.putInt("ExtraDamage", this.extraDamage);
        tag.putInt("Burning", this.burning);
    }

    @Override
    public void readAdditionalSaveData(CompoundTag tag) {
        super.readAdditionalSaveData(tag);
        this.extraDamage = tag.getInt("ExtraDamage");
        this.burning = tag.getInt("Burning");
    }

    @Override
    public void tick() {
        if (this.level() instanceof ServerLevel serverLevel) {
            serverLevel.sendParticles(ParticleTypes.LARGE_SMOKE,
                    this.getX(), this.getY(), this.getZ(),
                    3, 0.3D, 0.3D, 0.3D, 0.05D);
        }
        super.tick();
    }

    @Override public boolean isOnFire() { return false; }
    @Override public boolean isPickable() { return false; }
    @Override public boolean hurt(DamageSource source, float amount) { return false; }
    @Override protected boolean shouldBurn() { return false; }

    @Override
    protected void onHitEntity(EntityHitResult result) {
        if (this.level().isClientSide) return;

        Entity target = result.getEntity();
        Entity owner = this.getOwner();
        if (this.isFriendlyTo(owner, target)) return;

        target.hurt(this.damageSources().indirectMagic(this, owner), 12.0F + this.extraDamage);

        if (owner instanceof LivingEntity livingOwner) {
            this.doEnchantDamageEffects(livingOwner, target);
        }
        if (this.burning > 0 && target instanceof LivingEntity livingTarget) {
            livingTarget.setRemainingFireTicks(this.burning * 100);
        }
        if (this.level() instanceof ServerLevel serverLevel) {
            serverLevel.sendParticles(ParticleTypes.LAVA,
                    this.getX(), this.getY(), this.getZ(),
                    15, 0.4D, 0.4D, 0.4D, 0.15D);
        }
    }

    @Override
    protected void onHit(HitResult result) {
        if (this.level().isClientSide) {
            super.onHit(result);
            return;
        }

        if (result instanceof EntityHitResult entityHit) {
            this.onHitEntity(entityHit);
        }

        Entity owner = this.getOwner();
        double radius = 3.0D;

        List<LivingEntity> entities = this.level().getEntitiesOfClass(
                LivingEntity.class,
                this.getBoundingBox().inflate(radius),
                e -> !e.equals(this) && e != owner && !this.isFriendlyTo(owner, e));

        for (LivingEntity entity : entities) {
            double dist = entity.distanceTo(this);
            if (dist > radius) continue;

            double factor = 1.0D - (dist / radius);
            entity.hurt(this.damageSources().indirectMagic(this, owner),
                    (float) ((6.0D + this.extraDamage) * factor));

            if (this.burning > 0) {
                entity.setRemainingFireTicks(this.burning * 100);
            }

            Vec3 knockback = entity.position().subtract(this.position()).normalize().scale(factor * 0.5D);
            entity.push(knockback.x, 0.3D, knockback.z);
        }

        this.level().playSound(null, this.getX(), this.getY(), this.getZ(),
                SoundEvents.GENERIC_EXPLODE, SoundSource.BLOCKS, 1.0F, 1.0F);

        if (this.level() instanceof ServerLevel serverLevel) {
            serverLevel.sendParticles(ParticleTypes.EXPLOSION,
                    this.getX(), this.getY(), this.getZ(), 1, 0, 0, 0, 0);
            serverLevel.sendParticles(ParticleTypes.LAVA,
                    this.getX(), this.getY(), this.getZ(), 15, 0.4D, 0.4D, 0.4D, 0.15D);
        }
        this.discard();
    }

    private boolean isFriendlyTo(Entity owner, Entity target) {
        if (target == owner) return true;
        if (owner == null || target == null) return false;
        if (target.isAlliedTo(owner) || owner.isAlliedTo(target)) return true;
        return owner instanceof LivingEntity livingOwner
                && target instanceof LivingEntity livingTarget
                && MobUtil.areAllies(livingOwner, livingTarget);
    }
}
